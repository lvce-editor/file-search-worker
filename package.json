{
  "name": "@lvce-editor/file-search-worker-monorepo",
  "version": "0.0.0-dev",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.js",
    "build:static": "node packages/build/src/build-static.js",
    "build:watch": "npm exec --workspace=packages/build -- esbuild --format=esm --bundle --external:node:buffer --external:electron --external:ws --external:node:worker_threads --watch packages/file-search-worker/src/fileSearchWorkerMain.ts --outfile=.tmp/dist/dist/fileSearchWorkerMain.js",
    "dev": "node packages/build/src/dev.js",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check . && knip --no-config-hints",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.6.0",
    "@lvce-editor/eslint-plugin-github-actions": "^17.7.0",
    "eslint": "^10.8.0",
    "knip": "^6.29.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3"
  }
}
